@page
@model ProblemTalepTakipSistemiHalkbank.Pages.Bildirimler.TumuModel
@{
    ViewData["Title"] = "Bildirimler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1 text-dark">Bildirim Geçmişi</h3>
        <p class="text-muted small mb-0">Size ve görevlerinize ait tüm bildirimleri buradan takip edebilirsiniz.</p>
    </div>
    @if (Model.Bildirimler.Any(b => !b.OkunduMu))
    {
        <form method="post" asp-page-handler="HepsiniOkunduYap">
            <button type="submit" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
                <i class="bi bi-check2-all me-1"></i> Tümünü Okundu Say
            </button>
        </form>
    }
</div>

@if (!Model.Bildirimler.Any())
{
    <div class="alert alert-light border text-center py-5 rounded-4 shadow-sm">
        <i class="bi bi-bell-slash text-muted" style="font-size: 2.5rem;"></i>
        <h5 class="fw-bold mt-3 text-secondary">Henüz bir bildiriminiz yok</h5>
        <p class="text-muted small mb-0">Bir göreve atandığınızda veya durum değiştiğinde bildirimleriniz burada listelenir.</p>
    </div>
}
else
{
    <div class="list-group shadow-sm rounded-4 border-0 overflow-hidden">
        @foreach (var b in Model.Bildirimler)
        {
            <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-start p-3 border-start-0 border-end-0 @(!b.OkunduMu ? "bg-light border-primary border-3" : "")">
                <div class="d-flex align-items-start gap-3">
                    <div class="mt-1">
                        @if (!b.OkunduMu)
                        {
                            <span class="badge bg-primary rounded-circle p-2"><i class="bi bi-bell-fill"></i></span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary rounded-circle p-2"><i class="bi bi-check-lg"></i></span>
                        }
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h6 class="mb-1 fw-bold text-dark">@b.Baslik</h6>
                            @if (!b.OkunduMu)
                            {
                                <span class="badge bg-danger-subtle text-danger" style="font-size: 10px;">Yeni</span>
                            }
                        </div>
                        <p class="text-secondary small mb-2">@b.Mesaj</p>
                        <small class="text-muted"><i class="bi bi-clock me-1"></i>@b.OlusturulmaTarihi.ToString("dd MMMM yyyy HH:mm")</small>
                    </div>
                </div>

                <div class="d-flex flex-column align-items-end gap-2">
                    <a asp-page-handler="OkuVeGit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        Problemi Gör <i class="bi bi-arrow-right-short"></i>
                    </a>
                </div>
            </div>
        }
    </div>
}