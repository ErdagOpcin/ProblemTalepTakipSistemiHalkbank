@using Microsoft.AspNetCore.Identity
@using ProblemTalepTakipSistemiHalkbank.Data
@using ProblemTalepTakipSistemiHalkbank.Models
@using System.Linq

@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject ApplicationDbContext Context

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var userId = UserManager.GetUserId(User);
    var userEmail = (UserManager.GetUserName(User) ?? User.Identity?.Name ?? "").Trim().ToLower();

    // 1. Önce IdentityUserId ile ara, bulamazsa Email ile ara
    var personel = Context.Personeller.FirstOrDefault(p => 
        (!string.IsNullOrEmpty(p.IdentityUserId) && p.IdentityUserId == userId) ||
        (!string.IsNullOrEmpty(p.Email) && p.Email.ToLower() == userEmail)
    );

    var gorunenIsim = (personel != null && !string.IsNullOrWhiteSpace(personel.AdSoyad))
                        ? personel.AdSoyad
                        : (!string.IsNullOrEmpty(userEmail) ? userEmail : "Kullanıcı");

    <li class="nav-item">
        <div class="d-flex flex-column text-end justify-content-center" style="gap: 1px;">
            <a id="manage" class="text-dark fw-semibold text-decoration-none p-0" 
               style="font-size: 0.95rem; line-height: 1.2;" 
               asp-area="Identity" asp-page="/Account/Manage/Index" title="Hesap Yönetimi">
                Merhaba, @gorunenIsim!
            </a>
            
            <form id="logoutForm" class="d-inline m-0 p-0" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index", new { area = "" })">
                <button id="logout" type="submit" class="btn btn-link text-muted text-decoration-none p-0 border-0" 
                        style="font-size: 0.8rem; line-height: 1.2;">
                    Çıkış Yap
                </button>
            </form>
        </div>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" id="register" asp-area="Identity" asp-page="/Account/Register">Kayıt Ol</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" id="login" asp-area="Identity" asp-page="/Account/Login">Giriş Yap</a>
    </li>
}
</ul>