<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Problem Talep Takip Sistemi</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/ProblemTalepTakipSistemiHalkbank.styles.css"
          asp-append-version="true" />
</head>

<body>

    <div class="app-shell">

        <!-- SOL MENÜ -->
        <aside class="sidebar">

            <div class="sidebar-brand">

                <img src="~/images/halkbank-logo.jpeg"
                     asp-append-version="true"
                     alt="Halkbank"
                     class="halkbank-logo" />

            </div>

            <nav class="sidebar-menu">

                <a asp-page="/Index"
                   class="sidebar-link">

                    <span class="sidebar-icon">
                        ⌂
                    </span>

                    <span>
                        Ana Sayfa
                    </span>

                </a>

                <a asp-page="/Personeller/Index"
                   class="sidebar-link">

                    <span class="sidebar-icon">
                        👥
                    </span>

                    <span>
                        Personeller
                    </span>

                </a>

                <a asp-page="/Problemler/Index"
                   class="sidebar-link">

                    <span class="sidebar-icon">
                        ⚠
                    </span>

                    <span>
                        Problemler
                    </span>

                </a>

            </nav>

            <div class="sidebar-bottom">

                <div class="sidebar-line"></div>

                <div class="sidebar-bottom-title">
                    Problem Talep Takip Sistemi
                </div>

                <div class="sidebar-slogan">
                    Üreten Türkiye'nin Bankası
                </div>

            </div>

        </aside>


        <!-- SAĞ ANA ALAN -->
        <div class="main-area">

            <!-- ÜST BAR -->
            <header class="topbar">

                <div class="topbar-left">

                    <div class="topbar-system-title">
                        Problem Talep Takip Sistemi
                    </div>

                    <div class="topbar-system-subtitle">
                        Halkbank İç Sistem
                    </div>

                </div>

                <div class="topbar-user">

                    @await Html.PartialAsync("_LoginPartial")

                </div>

            </header>


            <!-- SAYFA İÇERİĞİ -->
            <main class="content-area">

                <div class="page-card">

                    @RenderBody()

                </div>

            </main>


            <!-- FOOTER -->
            <footer class="app-footer">

                <span>
                    &copy; 2026 Halkbank - Problem Talep Takip Sistemi
                </span>

                <span>
                    Üreten Türkiye'nin Bankası
                </span>

            </footer>

        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>