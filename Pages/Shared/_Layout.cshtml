<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Problem Talep Takip Sistemi</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Çan ikonu için Bootstrap Icons -->
    <link rel="stylesheet" 
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/ProblemTalepTakipSistemiHalkbank.styles.css"
          asp-append-version="true" />
</head>

<body>

    <div class="app-shell">

        <!-- SOL MENÜ -->
        <aside class="sidebar">

            <div class="sidebar-brand">

                <img src="~/images/halkbank-logo.jpeg"
                     asp-append-version="true"
                     alt="Halkbank"
                     class="halkbank-logo" />

            </div>

            <nav class="sidebar-menu">

                <a asp-page="/Index"
                   class="sidebar-link">

                    <span class="sidebar-icon">
                        ⌂
                    </span>

                    <span>
                        Ana Sayfa
                    </span>

                </a>

                <a asp-page="/Personeller/Index"
                   class="sidebar-link">

                    <span class="sidebar-icon">
                        👥
                    </span>

                    <span>
                        Personeller
                    </span>

                </a>

                <a asp-page="/Problemler/Index"
                   class="sidebar-link">

                    <span class="sidebar-icon">
                        ⚠
                    </span>

                    <span>
                        Problemler
                    </span>

                </a>

                <a asp-page="/Bildirimler/Tumu" class="sidebar-link">
                    <span class="sidebar-icon">
                        🔔
                    </span>
                    <span>
                        Bildirimler
                    </span>
                </a>

            </nav>

            <div class="sidebar-bottom">

                <div class="sidebar-line"></div>

                <div class="sidebar-bottom-title">
                    Problem Talep Takip Sistemi
                </div>

                <div class="sidebar-slogan">
                    Üreten Türkiye'nin Bankası
                </div>

            </div>

        </aside>


        <!-- SAĞ ANA ALAN -->
        <div class="main-area">

            <header class="topbar d-flex justify-content-between align-items-center px-4 py-2 bg-white border-bottom">

                <div class="topbar-left">
                    <div class="topbar-system-title fw-bold text-dark fs-5">
                        Problem Talep Takip Sistemi
                    </div>
                    <div class="topbar-system-subtitle text-muted small">
                        Halkbank İç Sistem
                    </div>
                </div>

                <div class="topbar-user d-flex align-items-center gap-3">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- BİLDİRİM ÇANI -->
                        <div class="dropdown position-relative">
                            <button class="btn btn-light rounded-circle position-relative p-2 border-0" 
                                    type="button" 
                                    id="bildirimDropdown" 
                                    data-bs-toggle="dropdown" 
                                    aria-expanded="false" 
                                    style="width: 40px; height: 40px;">
                                <i class="bi bi-bell-fill fs-5 text-secondary"></i>
                                <span id="bildirimSayisi" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" style="font-size: 10px;">
                                    0
                                </span>
                            </button>

                            <div class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-0 mt-2" 
                                aria-labelledby="bildirimDropdown" 
                                style="width: 320px; border-radius: 12px; z-index: 1050;">
                                <div class="d-flex justify-content-between align-items-center p-3 border-bottom bg-light" style="border-radius: 12px 12px 0 0;">
                                    <span class="fw-bold small mb-0">Bildirimler</span>
                                    <button class="btn btn-link btn-sm text-decoration-none p-0 text-primary fw-bold" id="btnTumunuOku" style="font-size: 11px;">
                                        Tümünü Oku
                                    </button>
                                </div>
                                <div id="bildirimListesi" style="max-height: 350px; overflow-y: auto;">
                                    <div class="text-center text-muted small py-3">Yükleniyor...</div>
                                </div>
                                <!-- Dropdown'ın içindeki listenin altına -->
                                <div class="p-2 border-top text-center bg-light" style="border-radius: 0 0 12px 12px;">
                                    <a asp-page="/Bildirimler/Tumu" class="text-decoration-none small fw-bold text-primary">
                                        Tüm Bildirimleri Gör &rarr;
                                    </a>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- Kullanıcı Bilgisi ve Logout -->
                    <div>
                        @await Html.PartialAsync("_LoginPartial")
                    </div>

                </div>

            </header>


            <!-- SAYFA İÇERİĞİ -->
            <main class="content-area">

                <div class="page-card">

                    @RenderBody()

                </div>

            </main>


            <!-- FOOTER -->
            <footer class="app-footer">

                <span>
                    &copy; 2026 Halkbank - Problem Talep Takip Sistemi
                </span>

                <span>
                    Üreten Türkiye'nin Bankası
                </span>

            </footer>

        </div>

    </div>

    <!-- Güvenlik Token'ı (AJAX POST için) -->
    <form id="antiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                yukleBildirimler();

                // Tümünü Okundu İşaretle butonu
                document.getElementById("btnTumunuOku")?.addEventListener("click", function (e) {
                    e.preventDefault();
                    const token = document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value || '';

                    fetch('/Bildirimler?handler=TumunuOku', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        }
                    }).then(() => {
                        yukleBildirimler();
                    });
                });
            });

            function yukleBildirimler() {
                fetch('/Bildirimler?handler=Bildirimler')
                    .then(res => res.json())
                    .then(data => {
                        const badge = document.getElementById("bildirimSayisi");
                        const liste = document.getElementById("bildirimListesi");

                        if (!badge || !liste) return;

                        if (data.sayi > 0) {
                            badge.textContent = data.sayi;
                            badge.classList.remove("d-none");
                        } else {
                            badge.classList.add("d-none");
                        }

                        liste.innerHTML = "";

                        if (!data.bildirimler || data.bildirimler.length === 0) {
                            liste.innerHTML = '<div class="text-center text-muted small py-4">Yeni bildiriminiz bulunmuyor.</div>';
                            return;
                        }

                        data.bildirimler.forEach(b => {
                            const item = document.createElement("a");
                            item.href = `/Problemler/Details?id=${b.problemId}`;
                            item.className = "dropdown-item p-2 border-bottom text-wrap";
                            item.style.whiteSpace = "normal";
                            item.innerHTML = `
                                <div class="fw-bold small text-primary">${b.baslik}</div>
                                <div class="text-secondary small" style="font-size: 12px;">${b.mesaj}</div>
                                <div class="text-muted mt-1" style="font-size: 10px;">${b.tarih}</div>
                            `;
                            liste.appendChild(item);
                        });
                    })
                    .catch(err => console.error("Bildirimler alınamadı:", err));
            }
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>