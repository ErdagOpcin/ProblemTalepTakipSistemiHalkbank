@page "{id:int}"
@model ProblemTalepTakipSistemiHalkbank.Pages.PersonelTasklari.UpdateModel

@{
    ViewData["Title"] = "Task Güncelle";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">

            <h4 class="mb-0">
                Task Güncelle
            </h4>

        </div>

        <div class="card-body">


            <div class="mb-4">

                <h5>
                    @Model.PersonelTask.Baslik
                </h5>

                <p class="text-muted mb-2">
                    @Model.PersonelTask.Aciklama
                </p>

                <div>
                    <strong>
                        Planlanan Efor:
                    </strong>

                    @Model.PersonelTask.PlanlananEfor.ToString("0.##") saat
                </div>

            </div>


            <form method="post">


                <div class="mb-3">

                    <label asp-for="HarcananEfor"
                           class="form-label">

                        Harcanan Efor (Saat)

                    </label>

                    <input asp-for="HarcananEfor"
                           type="number"
                           step="0.5"
                           min="0"
                           class="form-control" />

                    <span asp-validation-for="HarcananEfor"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="Durum"
                           class="form-label">

                        Task Durumu

                    </label>

                    <select asp-for="Durum"
                            class="form-select">

                        <option value="0">
                            Bekliyor
                        </option>

                        <option value="1">
                            Devam Ediyor
                        </option>

                        <option value="2">
                            Tamamlandı
                        </option>

                    </select>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        Kaydet

                    </button>


                    <a asp-page="/Index"
                       class="btn btn-secondary">

                        İptal

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>