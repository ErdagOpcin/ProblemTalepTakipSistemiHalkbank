@page
@model ProblemTalepTakipSistemiHalkbank.Pages.Problemler.CreateModel

@{
    ViewData["Title"] = "Yeni Problem Kaydı";
}

<div class="container-fluid px-4 py-3">

    <!-- Üst Başlık ve Geri Dön Butonu -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h4 class="mb-1 fw-bold text-dark">
                <i class="bi bi-plus-circle text-primary me-2"></i>Yeni Problem Kaydı Oluştur
            </h4>
            <span class="text-muted small">
                <i class="bi bi-info-circle me-1"></i>Sistemde yeni bir arıza, talep veya problem kaydı oluşturun.
            </span>
        </div>
        <a asp-page="./Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Listeye Dön
        </a>
    </div>

    <form method="post">
        <div class="row g-4">
            
            <!-- SOL KOLON: Form Giriş Alanları (7 Birim) -->
            <div class="col-lg-7 col-md-12">
                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-body p-4">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Problem Başlığı -->
                        <div class="mb-3">
                            <label asp-for="Problem.Baslik" class="form-label fw-semibold text-secondary">Problem Başlığı</label>
                            <input asp-for="Problem.Baslik" class="form-control" placeholder="Başlık giriniz..." required />
                            <span asp-validation-for="Problem.Baslik" class="text-danger small"></span>
                        </div>

                        <!-- Problem Açıklaması -->
                        <div class="mb-3">
                            <label asp-for="Problem.Aciklama" class="form-label fw-semibold text-secondary">Problem Detayı / Açıklama</label>
                            <textarea asp-for="Problem.Aciklama" class="form-control" rows="4" placeholder="Problem detaylarını buraya giriniz..."></textarea>
                            <span asp-validation-for="Problem.Aciklama" class="text-danger small"></span>
                        </div>

                        <!-- Durum ve Öncelik -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Problem.Durum" class="form-label fw-semibold text-secondary">Problem Durumu</label>
                                <select asp-for="Problem.Durum" asp-items="Html.GetEnumSelectList<ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu>()" class="form-select"></select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Problem.Oncelik" class="form-label fw-semibold text-secondary">Öncelik Seviyesi</label>
                                <select asp-for="Problem.Oncelik" asp-items="Html.GetEnumSelectList<ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik>()" class="form-select"></select>
                            </div>
                        </div>

                        <div class="row g-3 mb-3">
                        <!-- Şehir Seçimi -->
                        <div class="col-md-6">
                            <label asp-for="SelectedSehirId" class="form-label fw-semibold text-secondary">ŞEHİR</label>
                            <select asp-for="SelectedSehirId" asp-items="Model.SehirlerListesi" id="sehirDropdown" class="form-select">
                                <option value="">-- Şehir Seçiniz --</option>
                            </select>
                            <span asp-validation-for="SelectedSehirId" class="text-danger small"></span>
                        </div>

                        <!-- İlçe Seçimi -->
                        <div class="col-md-6">
                            <label asp-for="Problem.Ilce" class="form-label fw-semibold text-secondary">İLÇE</label>
                            <select asp-for="Problem.Ilce" id="ilceDropdown" class="form-select" disabled>
                                <option value="">-- Önce Şehir Seçiniz --</option>
                            </select>
                            <span asp-validation-for="Problem.Ilce" class="text-danger small"></span>
                        </div>
                    </div>

                        

                       <!-- Atanan Personeller Listesi (İş Yükü Sayaçlı) -->
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label fw-semibold text-secondary mb-0">ATANAN PERSONELLER</label>
                                <span class="text-muted small">Birden fazla personel seçebilirsiniz</span>
                            </div>

                            <div class="border rounded-3 p-2 bg-light shadow-inner" style="max-height: 250px; overflow-y: auto;">
                                @for (int i = 0; i < Model.PersonelListesi.Count; i++)
                                {
                                    var item = Model.PersonelListesi[i];
                                    var yukRengi = item.AktifGorevSayisi switch {
                                        0 => "bg-success bg-opacity-10 text-success border border-success",
                                        <= 2 => "bg-primary bg-opacity-10 text-primary border border-primary",
                                        <= 4 => "bg-warning bg-opacity-10 text-dark border border-warning",
                                        _ => "bg-danger bg-opacity-10 text-danger border border-danger"
                                    };

                                    <!-- LABEL ETIKETI TUM SATIRI KAPLAR -->
                                    <label class="form-check d-flex justify-content-between align-items-center p-2 mb-1 rounded bg-white shadow-sm"
                                        for="personel_@item.Id" style="cursor: pointer; user-select: none;">
                                        
                                        <div class="d-flex align-items-center">
                                            <!-- NAME NITELIGI DUZELTILDI: SecilenPersonelIds -->
                                            <input class="form-check-input ms-0 me-2 mt-0 flex-shrink-0" type="checkbox" 
                                                name="SecilenPersonelIds" value="@item.Id" 
                                                id="personel_@item.Id"
                                                @(Model.SecilenPersonelIds != null && Model.SecilenPersonelIds.Contains(item.Id) ? "checked" : "") />
                                            
                                            <span class="form-check-label fw-medium text-dark mb-0">
                                                @item.AdSoyad
                                                <span class="text-muted small ms-1">(@item.Departman)</span>
                                            </span>
                                        </div>

                                        <!-- Aktif İş Sayısı Rozeti -->
                                        <span class="badge rounded-pill @yukRengi px-2 py-1 small">
                                            <i class="bi bi-briefcase me-1"></i>@item.AktifGorevSayisi aktif iş
                                        </span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- İşlem Butonları -->
                        <div class="pt-3 border-top d-flex justify-content-end gap-2">
                            <a asp-page="./Index" class="btn btn-light border px-4">Vazgeç</a>
                            <button type="submit" class="btn btn-primary px-4 fw-medium"
                                    style="background: linear-gradient(135deg, #0d6efd 0%, #0099ff 100%); border: none;">
                                <i class="bi bi-check-circle me-1"></i>Kaydı Tamamla
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SAĞ KOLON: Bilgi ve İş Dağıtım Rehberi (5 Birim) -->
            <div class="col-lg-5 col-md-12">
                
                <!-- Bilgilendirme Kartı -->
                <div class="card shadow-sm border-0 rounded-3 mb-3">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-bold text-dark">
                            <i class="bi bi-info-circle-fill text-primary me-2"></i>Kayıt Bilgisi
                        </h6>
                    </div>
                    <div class="card-body">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Kayıt Türü:</span>
                                <span class="fw-semibold">Yeni Talep</span>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Tarih:</span>
                                <span>@DateTime.Now.ToString("dd.MM.yyyy HH:mm")</span>
                            </li>
                            <li class="list-group-item px-0 d-flex justify-content-between">
                                <span class="text-muted">Varsayılan Durum:</span>
                                <span class="badge bg-warning text-dark">Bekliyor</span>
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- İş Dağıtım Rehberi -->
                <div class="card shadow-sm border-0 rounded-3 bg-light">
                    <div class="card-body p-3">
                        <h6 class="fw-bold text-secondary mb-2">
                            <i class="bi bi-lightning-charge-fill text-warning me-1"></i>İş Dağıtım Rehberi
                        </h6>
                        <p class="small text-muted mb-2">
                            Personellerin yanında görünen sayaçlar, şu an aktif olarak üzerlerinde açık olan çözülmemiş görev sayısını gösterir:
                        </p>
                        <div class="d-flex flex-wrap gap-2 small">
                            <span class="badge bg-success bg-opacity-10 text-success border border-success">0 Görev: Boşta</span>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary">1-2 Görev: Normal</span>
                            <span class="badge bg-warning bg-opacity-10 text-dark border border-warning">3-4 Görev: Yoğun</span>
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">5+ Görev: Aşırı Yüklü</span>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </form>
</div>

    @section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        document.getElementById("sehirDropdown")?.addEventListener("change", function () {
            const sehirId = this.value;
            const ilceDropdown = document.getElementById("ilceDropdown");

            ilceDropdown.innerHTML = '<option value="">-- İlçe Seçiniz --</option>';

            if (!sehirId) {
                ilceDropdown.disabled = true;
                ilceDropdown.innerHTML = '<option value="">-- Önce Şehir Seçiniz --</option>';
                return;
            }

            // Backend'deki OnGetIlcelerAsync metodunu tetikler
            fetch(`?handler=Ilceler&sehirId=${sehirId}`)
                .then(res => res.json())
                .then(data => {
                    if (data && data.length > 0) {
                        ilceDropdown.disabled = false;
                        data.forEach(item => {
                            const option = document.createElement("option");
                            option.value = item.name; // Problem tablosuna ilçe ismi kaydedilir
                            option.textContent = item.name;
                            ilceDropdown.appendChild(option);
                        });
                    } else {
                        ilceDropdown.disabled = true;
                        ilceDropdown.innerHTML = '<option value="">İlçe bulunamadı</option>';
                    }
                })
                .catch(err => {
                    console.error("İlçeler getirilemedi:", err);
                    ilceDropdown.disabled = true;
                });
        });
    </script>
    }
