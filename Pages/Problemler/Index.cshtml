@page
@model ProblemTalepTakipSistemiHalkbank.Pages.Problemler.IndexModel

@{
    ViewData["Title"] = "Problem Listesi";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Problem Takip Listesi</h2>

        @if (User.IsInRole("Admin"))
        {
            <a asp-page="Create" class="btn btn-primary">
                + Yeni Problem Ekle
            </a>
        }

    </div>

    <!-- Filtreleme Kartı -->
    <div class="card shadow-sm border-0 mb-4" style="border-radius: 10px; background-color: #f8fafc;">
        <div class="card-body p-3">
            <form method="get">
                <div class="row g-3 align-items-end">
                    
                    <!-- Durum Filtresi -->
                    <div class="col-md-3">
                        <label asp-for="DurumFiltre" class="form-label fw-bold small text-muted text-uppercase mb-1">
                            Durum
                        </label>
                        <select asp-for="DurumFiltre"
                                asp-items="Html.GetEnumSelectList<ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu>()"
                                class="form-select"
                                onchange="this.form.submit()">
                            <option value="">-- Tüm Durumlar --</option>
                        </select>
                    </div>

                    <!-- Öncelik Filtresi -->
                    <div class="col-md-3">
                        <label asp-for="SecilenOncelik" class="form-label fw-bold small text-muted text-uppercase mb-1">
                            Öncelik
                        </label>
                        <select asp-for="SecilenOncelik" 
                                asp-items="Html.GetEnumSelectList<ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik>()" 
                                class="form-select" 
                                onchange="this.form.submit()">
                            <option value="">-- Tüm Öncelikler --</option>
                        </select>
                    </div>

                    <!-- Atanan Personel Filtresi -->
                    <div class="col-md-3">
                        <label asp-for="SecilenPersonelId" class="form-label fw-bold small text-muted text-uppercase mb-1">
                            Atanan Personel
                        </label>
                        <select asp-for="SecilenPersonelId" 
                                asp-items="Model.PersonelListesi" 
                                class="form-select" 
                                onchange="this.form.submit()">
                            <option value="">-- Tüm Personeller --</option>
                        </select>
                    </div>

                    <!-- Filtreleri Temizle Butonu (Her zaman görünür ve tabana hizalı) -->
                    <div class="col-md-3">
                        <label class="form-label d-none d-md-block small mb-1" style="visibility: hidden;">Boşluk</label>
                        <a asp-page="./Index" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-1" style="height: 38px;">
                            <i class="bi bi-x-circle"></i>
                            <span>Filtreleri Temizle</span>
                        </a>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <table class="table table-striped table-hover mb-0">

                <thead class="table-dark">

                    <tr>
                        <th>Tarih</th>
                        <th>Başlık</th>
                        <th>Şehir</th>
                        <th>Öncelik</th>
                        <th>Durum</th>
                        <th>Çözülme Tarihi</th>
                        <th>Atanan Personel</th>

                        @if (User.IsInRole("Admin"))
                        {
                            <th>İşlemler</th>
                        }
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Problemler != null && Model.Problemler.Any())
                    {
                        @foreach (var item in Model.Problemler)
                        {
                            var durumYazi = item.Durum switch
                            {
                                ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu.Bekliyor
                                    => "Bekliyor",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu.IslemeAlindi
                                    => "İşleme Alındı",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu.Cozuldu
                                    => "Çözüldü",

                                _ => item.Durum.ToString()
                            };

                            var durumRenk = item.Durum switch
                            {
                                ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu.Bekliyor
                                    => "bg-warning text-dark",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu.IslemeAlindi
                                    => "bg-primary",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu.Cozuldu
                                    => "bg-success",

                                _ => "bg-secondary"
                            };

                            var oncelikYazi = item.Oncelik switch
                            {
                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Dusuk
                                    => "Düşük",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Orta
                                    => "Orta",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Yuksek
                                    => "Yüksek",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Kritik
                                    => "Kritik",

                                _ => item.Oncelik.ToString()
                            };

                            var oncelikRenk = item.Oncelik switch
                            {
                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Dusuk
                                    => "bg-success",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Orta
                                    => "bg-primary",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Yuksek
                                    => "bg-warning text-dark",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Kritik
                                    => "bg-danger",

                                _ => "bg-secondary"
                            };

                            <tr>

                                <td>
                                    @(item.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm"))
                                </td>

                                <td>
                                    <strong>@item.Baslik</strong>
                                </td>

                                <td>
                                    @item.Sehir
                                </td>

                                <td>
                                    <span class="badge @oncelikRenk">
                                        @oncelikYazi
                                    </span>
                                </td>

                                <td>
                                    <span class="badge @durumRenk">
                                        @durumYazi
                                    </span>
                                </td>

                                <td>
                                    @if (item.CozulmeTarihi.HasValue)
                                    {
                                        @(item.CozulmeTarihi.Value.ToString("dd.MM.yyyy HH:mm"))
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @(item.ProblemPersoneller != null && item.ProblemPersoneller.Any()
                                        ? string.Join(", ", item.ProblemPersoneller.Select(pp => pp.Personel.AdSoyad))
                                        : "Atanmadı")
                                </td>

                                <td>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-page="./DurumGuncelle" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Durum Güncelle</a>
                                    }
                                    <a asp-page="./Detay" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">Detay</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(User.IsInRole("Admin") ? 8 : 7)"
                                class="text-center py-3 text-muted">

                                Bu filtreye uygun problem bulunamadı.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>