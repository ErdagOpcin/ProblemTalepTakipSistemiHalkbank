@page
@model ProblemTalepTakipSistemiHalkbank.Pages.Problemler.IndexModel

@{
    ViewData["Title"] = "Problem Listesi";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Problem Takip Listesi</h2>

        @if (User.IsInRole("Admin"))
        {
            <a asp-page="Create" class="btn btn-primary">
                + Yeni Problem Ekle
            </a>
        }

    </div>

    <form method="get" class="row mb-3">

        <div class="col-md-4">

            <label asp-for="DurumFiltre" class="form-label fw-bold">
                Duruma Göre Filtrele:
            </label>

            <select asp-for="DurumFiltre"
                    asp-items="Html.GetEnumSelectList<ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu>()"
                    class="form-select"
                    onchange="this.form.submit()">

                <option value="">-- Tüm Durumlar --</option>

            </select>

        </div>

    </form>

    <div class="card shadow-sm">

        <div class="card-body p-0">

            <table class="table table-striped table-hover mb-0">

                <thead class="table-dark">

                    <tr>
                        <th>Tarih</th>
                        <th>Başlık</th>
                        <th>Şehir</th>
                        <th>Öncelik</th>
                        <th>Durum</th>
                        <th>Çözülme Tarihi</th>
                        <th>Atanan Personel</th>

                        @if (User.IsInRole("Admin"))
                        {
                            <th>İşlemler</th>
                        }
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Problemler != null && Model.Problemler.Any())
                    {
                        @foreach (var item in Model.Problemler)
                        {
                            var durumYazi = item.Durum switch
                            {
                                ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu.Bekliyor
                                    => "Bekliyor",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu.IslemeAlindi
                                    => "İşleme Alındı",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu.Cozuldu
                                    => "Çözüldü",

                                _ => item.Durum.ToString()
                            };

                            var durumRenk = item.Durum switch
                            {
                                ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu.Bekliyor
                                    => "bg-warning text-dark",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu.IslemeAlindi
                                    => "bg-primary",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemDurumu.Cozuldu
                                    => "bg-success",

                                _ => "bg-secondary"
                            };

                            var oncelikYazi = item.Oncelik switch
                            {
                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Dusuk
                                    => "Düşük",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Orta
                                    => "Orta",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Yuksek
                                    => "Yüksek",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Kritik
                                    => "Kritik",

                                _ => item.Oncelik.ToString()
                            };

                            var oncelikRenk = item.Oncelik switch
                            {
                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Dusuk
                                    => "bg-success",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Orta
                                    => "bg-primary",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Yuksek
                                    => "bg-warning text-dark",

                                ProblemTalepTakipSistemiHalkbank.Models.ProblemOncelik.Kritik
                                    => "bg-danger",

                                _ => "bg-secondary"
                            };

                            <tr>

                                <td>
                                    @(item.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm"))
                                </td>

                                <td>
                                    <strong>@item.Baslik</strong>
                                </td>

                                <td>
                                    @item.Sehir
                                </td>

                                <td>
                                    <span class="badge @oncelikRenk">
                                        @oncelikYazi
                                    </span>
                                </td>

                                <td>
                                    <span class="badge @durumRenk">
                                        @durumYazi
                                    </span>
                                </td>

                                <td>
                                    @if (item.CozulmeTarihi.HasValue)
                                    {
                                        @(item.CozulmeTarihi.Value.ToString("dd.MM.yyyy HH:mm"))
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @(item.ProblemPersoneller != null && item.ProblemPersoneller.Any()
                                        ? string.Join(", ", item.ProblemPersoneller.Select(pp => pp.Personel.AdSoyad))
                                        : "Atanmadı")
                                </td>

                                <td>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-page="./DurumGuncelle" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Durum Güncelle</a>
                                    }
                                    <a asp-page="./Detay" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">Detay</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(User.IsInRole("Admin") ? 8 : 7)"
                                class="text-center py-3 text-muted">

                                Bu filtreye uygun problem bulunamadı.

                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>