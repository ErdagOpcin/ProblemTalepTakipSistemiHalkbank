@page "{id:int}"
@model ProblemTalepTakipSistemiHalkbank.Pages.Personeller.EditModel
@{
    ViewData["Title"] = "Personel Düzenle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-warning text-dark">
                    <h4 class="mb-0">Personel Bilgilerini Düzenle</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <!-- Id değerini gizli tutuyoruz ki hangi personelin güncellendiği kaybolmasın -->
                        <input type="hidden" asp-for="Personel.Id" />

                        <div class="mb-3">
                            <label asp-for="Personel.AdSoyad" class="form-label">Ad Soyad</label>
                            <input asp-for="Personel.AdSoyad" class="form-control" required />
                            <span asp-validation-for="Personel.AdSoyad" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Personel.Departman" class="form-label">Departman</label>
                            <input asp-for="Personel.Departman" class="form-control" required />
                            <span asp-validation-for="Personel.Departman" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="./Index" class="btn btn-secondary">Geri Dön</a>
                            <button type="submit" class="btn btn-warning">Güncelle</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>