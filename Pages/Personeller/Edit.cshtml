@page "{id:int}"
@model ProblemTalepTakipSistemiHalkbank.Pages.Personeller.EditModel

@{
    ViewData["Title"] = "Personel Düzenle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                <!-- Canlı Mavi Başlık -->
                <div class="card-header text-white py-3 d-flex justify-content-between align-items-center"
                     style="background: linear-gradient(135deg, #0d6efd 0%, #0099ff 100%);">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-pencil-square me-2"></i>Personel Bilgilerini Düzenle
                    </h5>
                    <span class="badge bg-white text-primary fw-bold px-3 py-2 rounded-pill shadow-sm">
                        ID: #@Model.Personel.Id
                    </span>
                </div>

                <div class="card-body p-4">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="Personel.Id" />
                        <input type="hidden" asp-for="Personel.IdentityUserId" />

                        <!-- Ad Soyad -->
                        <div class="mb-3">
                            <label asp-for="Personel.AdSoyad" class="form-label fw-semibold text-secondary">Ad Soyad</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-person text-primary"></i>
                                </span>
                                <input asp-for="Personel.AdSoyad" class="form-control border-start-0 ps-0" placeholder="Örn: Ahmet Yılmaz" />
                            </div>
                            <span asp-validation-for="Personel.AdSoyad" class="text-danger small"></span>
                        </div>

                        <!-- E-Posta Adresi -->
                        <div class="mb-3">
                            <label asp-for="Personel.Email" class="form-label fw-semibold text-secondary">E-Posta Adresi</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-envelope text-primary"></i>
                                </span>
                                <input asp-for="Personel.Email" class="form-control border-start-0 ps-0" type="email" placeholder="ornek@halkbank.com.tr" readonly />
                            </div>
                            <span asp-validation-for="Personel.Email" class="text-danger small"></span>
                            <div class="form-text text-muted small">
                                <i class="bi bi-info-circle me-1"></i>E-posta adresi personelin sisteme giriş kullanıcı adıdır.
                            </div>
                        </div>

                        <!-- Departman -->
                        <div class="mb-4">
                            <label asp-for="Personel.Departman" class="form-label fw-semibold text-secondary">Departman</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-building text-primary"></i>
                                </span>
                                <input asp-for="Personel.Departman" class="form-control border-start-0 ps-0" placeholder="Örn: Bilgi Teknolojileri" />
                            </div>
                            <span asp-validation-for="Personel.Departman" class="text-danger small"></span>
                        </div>

                        <!-- Butonlar -->
                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <a asp-page="./Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Listeye Dön
                            </a>
                            <button type="submit" class="btn btn-primary px-4 fw-medium"
                                    style="background: linear-gradient(135deg, #0d6efd 0%, #0099ff 100%); border: none;">
                                <i class="bi bi-check2-circle me-1"></i>Değişiklikleri Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}