@page
@model ProblemTalepTakipSistemiHalkbank.Pages.Personeller.CreateModel
@{
    ViewData["Title"] = "Yeni Personel Ekle";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Yeni Personel Ekle</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Personel.AdSoyad" class="form-label">Ad Soyad</label>
                            <input asp-for="Personel.AdSoyad" class="form-control" placeholder="Örn: Ahmet Yılmaz" required />
                            <span asp-validation-for="Personel.AdSoyad" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Personel.Departman" class="form-label">Departman / Birim</label>
                            <input asp-for="Personel.Departman" class="form-control" placeholder="Örn: Bilgi Teknolojileri" required />
                            <span asp-validation-for="Personel.Departman" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="Index" class="btn btn-secondary">Geri Dön</a>
                            <button type="submit" class="btn btn-success">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>