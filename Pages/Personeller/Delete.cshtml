@page "{id:int}"
@model ProblemTalepTakipSistemiHalkbank.Pages.Personeller.DeleteModel

@{
    ViewData["Title"] = "Personel Sil";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0">Personel Sil</h4>
                </div>

                <div class="card-body">
                    <dl class="row mb-4">
                        <dt class="col-sm-4">Ad Soyad:</dt>
                        <dd class="col-sm-8 fw-bold">@Model.Personel.AdSoyad</dd>

                        <dt class="col-sm-4">E-posta:</dt>
                        <dd class="col-sm-8">@Model.Personel.Email</dd>

                        <dt class="col-sm-4">Departman:</dt>
                        <dd class="col-sm-8">@Model.Personel.Departman</dd>
                    </dl>

                    <div class="d-flex justify-content-between">
                        <a asp-page="./Index" class="btn btn-secondary">Vazgeç</a>
                        <!-- Modal'ı tetikleyen Sil butonu -->
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#silOnayModal">
                            Sil
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- "Emin misiniz?" Açılır Onay Ekranı (Modal) -->
<div class="modal fade" id="silOnayModal" tabindex="-1" aria-labelledby="modalBaslik" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalBaslik">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Silme Onayı
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <p class="fs-5 mb-1">Bu personeli silmek istediğinizden <strong>emin misiniz?</strong></p>
                <p class="text-muted small mb-0">Personel ve sisteme giriş hesabı kalıcı olarak kaldırılacaktır.</p>
            </div>
            <div class="modal-footer justify-content-center bg-light">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Hayır, Vazgeç</button>
                <form method="post" class="d-inline">
                    <input type="hidden" asp-for="Personel.Id" />
                    <button type="submit" class="btn btn-danger px-4">Evet, Eminim</button>
                </form>
            </div>
        </div>
    </div>
</div>