@page "{id:int}"
@model ProblemTalepTakipSistemiHalkbank.Pages.Personeller.DetayModel

@{
    ViewData["Title"] = "Personel Detayı";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            <!-- Personel Bilgi Kartı -->
            <div class="card shadow-sm border-0 rounded-3 mb-4 overflow-hidden">
                <div class="card-header text-white py-3 d-flex justify-content-between align-items-center" 
                    style="background: linear-gradient(135deg, #0d6efd 0%, #0099ff 100%);">
                    <h5 class="card-title mb-0 fw-bold">
                        <i class="bi bi-person-lines-fill me-2"></i>Personel Detay Bilgileri
                    </h5>
                    <span class="badge bg-white text-primary fw-bold px-3 py-2 rounded-pill shadow-sm">ID: #@Model.Personel.Id</span>
                </div>
                <div class="card-body p-4">
                    <dl class="row mb-0 gy-3">
                        <dt class="col-sm-4 text-muted fw-normal">Ad Soyad</dt>
                        <dd class="col-sm-8 fw-bold fs-5 text-dark mb-0">@Model.Personel.AdSoyad</dd>

                        <dt class="col-sm-4 text-muted fw-normal">E-Posta Adresi</dt>
                        <dd class="col-sm-8 mb-0">
                            <i class="bi bi-envelope-fill text-primary me-2"></i>
                            <a href="mailto:@Model.Personel.Email" class="text-decoration-none fw-medium text-primary">
                                @Model.Personel.Email
                            </a>
                        </dd>

                        <dt class="col-sm-4 text-muted fw-normal">Departman</dt>
                        <dd class="col-sm-8 fw-semibold text-dark mb-0">
                            @Model.Personel.Departman
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Görev & Performans İstatistikleri -->
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-light py-3">
                    <h6 class="mb-0 fw-bold text-dark">
                        <i class="bi bi-bar-chart-fill text-primary me-2"></i>Görev ve Problem İstatistikleri
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="row text-center g-3">
                        <div class="col-sm-4">
                            <div class="p-3 border rounded-3 bg-light">
                                <span class="text-muted small d-block mb-1">Toplam Görev</span>
                                <span class="fs-4 fw-bold text-dark">@Model.ToplamGorevSayisi</span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="p-3 border border-success rounded-3 bg-success bg-opacity-10">
                                <span class="text-success small d-block mb-1 fw-bold">Tamamlanan Görev</span>
                                <span class="fs-4 fw-bold text-success">@Model.TamamlananGorevSayisi</span>
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="p-3 border border-warning rounded-3 bg-warning bg-opacity-10">
                                <span class="text-warning small d-block mb-1 fw-bold">Devam Eden Görev</span>
                                <span class="fs-4 fw-bold text-warning">@Model.DevamEdenGorevSayisi</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Aksiyon Butonları -->
            <div class="d-flex justify-content-between">
                <a asp-page="./Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Listeye Dön
                </a>
                <div>
                    <a asp-page="./Edit" asp-route-id="@Model.Personel.Id" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i>Düzenle
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>