@page "{id:int}"
@model ProblemTalepTakipSistemiHalkbank.Pages.Personeller.DetayModel

@{
    ViewData["Title"] = "Personel Detayı";
}

<div class="container mt-4" style="max-width: 900px;">
    <!-- Personel Bilgi Kartı -->
    <div class="card shadow-sm border-0 mb-4" style="border-top: 4px solid #003366 !important; border-radius: 8px;">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <div>
                <h4 class="mb-0 fw-bold" style="color: #003366;">
                    <i class="bi bi-person-badge me-2"></i>@Model.Personel.AdSoyad
                </h4>
                <small class="text-muted">Personel Bilgileri ve Görev Dağılımı</small>
            </div>
            <a asp-page="/Personeller/Index" class="btn btn-outline-secondary btn-sm">
                ← Personel Listesi
            </a>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted small text-uppercase">Ad Soyad</label>
                    <input type="text" class="form-control bg-light" value="@Model.Personel.AdSoyad" readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted small text-uppercase">Departman / Birim</label>
                    <input type="text" class="form-control bg-light" value="@Model.Personel.Departman" readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted small text-uppercase">Toplam Atanan Görev</label>
                    <input type="text" class="form-control bg-light fw-bold text-primary" 
                           value="@(Model.Personel.ProblemPersoneller?.Count ?? 0) Problem" readonly />
                </div>
            </div>
        </div>
    </div>

    <!-- Personele Atanmış Problemler Tablosu -->
    <div class="card shadow-sm border-0" style="border-radius: 8px;">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold text-dark">
                <i class="bi bi-list-task me-2 text-primary"></i>Personele Atanan Problemler
            </h5>
        </div>
        <div class="card-body p-0">
            @if (Model.Personel.ProblemPersoneller != null && Model.Personel.ProblemPersoneller.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Başlık</th>
                                <th>Öncelik</th>
                                <th>Durum</th>
                                <th>İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pp in Model.Personel.ProblemPersoneller)
                            {
                                <tr>
                                    <td class="fw-bold text-muted">#@pp.Problem.Id</td>
                                    <td>@pp.Problem.Baslik</td>
                                    <td>
                                        <span class="badge bg-secondary">@pp.Problem.Oncelik</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info text-dark">@pp.Problem.Durum</span>
                                    </td>
                                    <td>
                                        <a asp-page="/Problemler/Detay" asp-route-id="@pp.ProblemId" class="btn btn-sm btn-outline-primary">
                                            İncele
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    Bu personele henüz atanmış bir problem bulunmuyor.
                </div>
            }
        </div>
    </div>
</div>