@page
@model ProblemTalepTakipSistemiHalkbank.Pages.Personeller.IndexModel
@{
    ViewData["Title"] = "Personel Listesi";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Personel Listesi</h2>
        <a asp-page="Create" class="btn btn-primary">+ Yeni Personel Ekle</a>
    </div>

    <!-- API'den gelen Türkiye Şehirleri Seçim/Filtre Kutusu -->
    <div class="row mb-3">
        <div class="col-md-4">
            <label for="sehirSecimi" class="form-label fw-bold">Şehir Seçiniz / Filtrele:</label>
            <select id="sehirSecimi" class="form-select">
                <option value="">-- Tüm İller (@Model.Cities.Count İl) --</option>
                @foreach (var city in Model.Cities)
                {
                    <option value="@city.Id">@city.sehirIsmi</option>
                }
            </select>
        </div>
    </div>

    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Ad Soyad</th>
                <th>Birim / Departman</th>
                <th>İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.PersonelListesi != null && Model.PersonelListesi.Any())
            {
                @foreach (var personel in Model.PersonelListesi)
                {
                    <tr>
                        <td>@personel.Id</td>
                        <td>@personel.AdSoyad</td>
                        <!--departman yerine birim yazılabilir-->
                        <td>@personel.Departman</td>
                        <td>
                            <a asp-page="./Edit" asp-route-id="@personel.Id" class="btn btn-sm btn-warning">Düzenle</a>
                            <a asp-page="./Delete" asp-route-id="@personel.Id" class="btn btn-sm btn-danger ms-1">Sil</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted py-3">Henüz kayıtlı personel bulunmamaktadır.</td>
                </tr>
            }
        </tbody>
    </table>
</div>