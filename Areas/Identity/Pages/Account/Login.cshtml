@page
@model LoginModel

@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
}

<!DOCTYPE html>

<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Giriş Yap - Problem Talep Takip Sistemi
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body class="login-page">


    <div class="login-background">

        <div class="login-overlay"></div>


        <div class="login-brand-area">

            <img src="~/images/halkbank-logo.jpeg"
                 asp-append-version="true"
                 alt="Halkbank"
                 class="login-halkbank-logo" />

            <div class="login-brand-text">

                <h1>
                    Problem Talep<br />
                    Takip Sistemi
                </h1>

                <p>
                    Halkbank İç Sistem
                </p>

            </div>

        </div>


        <div class="login-card-wrapper">

            <div class="login-card">

                <div class="login-card-header">

                    <span class="login-small-title">
                        HOŞ GELDİNİZ
                    </span>

                    <h2>
                        Giriş Yap
                    </h2>

                    <p>
                        Problem Talep Takip Sistemi'ne
                        erişmek için hesabınızla giriş yapın.
                    </p>

                </div>


                <form id="account"
                      method="post"
                      class="login-form">


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger login-validation"
                         role="alert">
                    </div>


                    <div class="login-field">

                        <label asp-for="Input.Email"
                               class="login-label">
                            E-posta
                        </label>

                        <input asp-for="Input.Email"
                               class="form-control login-input"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="ornek@halkbank.com.tr" />

                        <span asp-validation-for="Input.Email"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="login-field">

                        <label asp-for="Input.Password"
                               class="login-label">
                            Şifre
                        </label>

                        <input asp-for="Input.Password"
                               class="form-control login-input"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="Şifrenizi girin" />

                        <span asp-validation-for="Input.Password"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="login-options">

                        <label class="remember-me">

                            <input asp-for="Input.RememberMe"
                                   class="form-check-input" />

                            <span>
                                Beni Hatırla
                            </span>

                        </label>

                    </div>


                    <button id="login-submit"
                            type="submit"
                            class="login-button">

                        Giriş Yap

                    </button>


                    <div class="login-register">

                        <span>
                            Hesabınız yok mu?
                        </span>

                        <a asp-page="./Register"
                           asp-route-returnUrl="@Model.ReturnUrl">

                            Kayıt Ol

                        </a>

                    </div>


                </form>


                <div class="login-card-footer">

                    <span>
                        Güvenli erişim
                    </span>

                    <span class="login-footer-dot">
                        •
                    </span>

                    <span>
                        Halkbank
                    </span>

                </div>

            </div>

        </div>


        <div class="login-page-footer">

            © 2026 Halkbank - Problem Talep Takip Sistemi

        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <partial name="_ValidationScriptsPartial" />


</body>

</html>