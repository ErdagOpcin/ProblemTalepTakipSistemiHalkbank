@page
@model LoginModel

@{
    ViewData["Title"] = "Giriş Yap";
    Layout = null;
}

<!DOCTYPE html>

<html lang="tr">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        Giriş Yap - Problem Talep Takip Sistemi
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            font-family:
                -apple-system,
                BlinkMacSystemFont,
                "Segoe UI",
                Roboto,
                Helvetica,
                Arial,
                sans-serif;
        }


        /* =====================================================
           ANA LOGIN SAYFASI
           ===================================================== */

        .hb-login-page {
            position: relative;

            min-height: 100vh;

            overflow: hidden;

            display: flex;

            background:
                linear-gradient(
                    90deg,
                    rgba(1, 24, 45, 0.66) 0%,
                    rgba(2, 43, 76, 0.50) 42%,
                    rgba(1, 37, 67, 0.22) 72%,
                    rgba(0, 20, 38, 0.08) 100%
                ),
                url('/images/halkbank-building-hd.jpg');

            background-size: cover;

            background-position: center;

            background-repeat: no-repeat;
        }


        .hb-login-page::after {
            content: "";

            position: absolute;

            inset: 0;

            z-index: 1;

            pointer-events: none;

            background:
                linear-gradient(
                    180deg,
                    rgba(1, 17, 33, 0.08) 0%,
                    rgba(1, 17, 33, 0.00) 55%,
                    rgba(1, 17, 33, 0.32) 100%
                );
        }


        /* =====================================================
           SOL TARAF
           ===================================================== */

        .hb-login-brand {
            position: relative;

            z-index: 3;

            width: 58%;

            min-height: 100vh;

            display: flex;

            flex-direction: column;

            justify-content: center;

            padding:
                70px 60px 90px 6%;
        }


        .hb-brand-content {
            max-width: 610px;
        }


        /* KISA MAVİ ÇİZGİ */

        .hb-brand-line {
            width: 62px;

            height: 4px;

            margin-bottom: 30px;

            border-radius: 10px;

            background:
                linear-gradient(
                    90deg,
                    #12a2ee,
                    #0483cc
                );

            box-shadow:
                0 0 18px rgba(0, 149, 230, 0.34);
        }


        /* BAŞLIK */

        .hb-brand-title {
            max-width: 560px;

            margin:
                0 0 18px 0;

            color: white;

            font-size: 53px;

            font-weight: 760;

            line-height: 1.08;

            letter-spacing: -1.6px;

            text-shadow:
                0 5px 22px rgba(0, 0, 0, 0.27);
        }


        /* AÇIKLAMA */

        .hb-brand-description {
            max-width: 480px;

            margin: 0;

            color:
                rgba(255, 255, 255, 0.82);

            font-size: 19px;

            line-height: 1.55;

            text-shadow:
                0 3px 12px rgba(0, 0, 0, 0.20);
        }


        /* =====================================================
           ALT ÖZELLİKLER
           ===================================================== */

        .hb-features {
            display: flex;

            align-items: stretch;

            gap: 0;

            margin-top: 48px;

            max-width: 560px;
        }


        .hb-feature {
            width: 33.333%;

            padding:
                0 25px;

            text-align: center;

            color:
                rgba(255, 255, 255, 0.94);

            border-right:
                1px solid rgba(255, 255, 255, 0.30);
        }


        .hb-feature:first-child {
            padding-left: 0;
        }


        .hb-feature:last-child {
            padding-right: 0;

            border-right: none;
        }


        .hb-feature-icon {
            width: 45px;

            height: 45px;

            margin:
                0 auto 11px auto;

            display: flex;

            align-items: center;

            justify-content: center;

            color: white;

            border:
                1px solid rgba(255, 255, 255, 0.52);

            border-radius: 12px;

            background:
                rgba(255, 255, 255, 0.06);

            backdrop-filter:
                blur(8px);

            -webkit-backdrop-filter:
                blur(8px);

            font-size: 20px;
        }


        .hb-feature-title {
            display: block;

            font-size: 13px;

            font-weight: 650;

            line-height: 1.35;
        }


        /* =====================================================
           SAĞ ÜST SLOGAN
           ===================================================== */

        .hb-top-slogan {
            position: absolute;

            z-index: 4;

            top: 42px;

            right: 5%;

            display: flex;

            align-items: center;

            gap: 16px;

            color:
                rgba(255, 255, 255, 0.92);

            font-size: 11px;

            font-weight: 700;

            letter-spacing: 3px;
        }


        .hb-top-slogan::after {
            content: "";

            width: 58px;

            height: 1px;

            background:
                rgba(64, 183, 239, 0.88);
        }


        /* =====================================================
           SAĞ TARAF
           ===================================================== */

        .hb-login-side {
            position: relative;

            z-index: 4;

            width: 42%;

            min-height: 100vh;

            display: flex;

            align-items: center;

            justify-content: center;

            padding:
                95px 5% 85px 25px;
        }


        .hb-login-card {
            width: 100%;

            max-width: 510px;

            padding:
                46px 47px 31px 47px;

            background:
                rgba(255, 255, 255, 0.97);

            border:
                1px solid rgba(255, 255, 255, 0.72);

            border-radius: 24px;

            box-shadow:
                0 30px 85px rgba(0, 18, 35, 0.31);

            backdrop-filter:
                blur(16px);

            -webkit-backdrop-filter:
                blur(16px);
        }


        /* =====================================================
           LOGIN BAŞLIK
           ===================================================== */

        .hb-login-small-title {
            display: block;

            margin-bottom: 9px;

            color: #0875c5;

            font-size: 11px;

            font-weight: 800;

            letter-spacing: 2.2px;
        }


        .hb-login-card h2 {
            margin:
                0 0 10px 0;

            color: #173a5e;

            font-size: 34px;

            font-weight: 750;

            letter-spacing: -0.5px;
        }


        .hb-login-description {
            max-width: 365px;

            margin:
                0 0 31px 0;

            color: #71859a;

            font-size: 14px;

            line-height: 1.6;
        }


        /* =====================================================
           FORM
           ===================================================== */

        .hb-validation {
            margin-bottom: 14px;

            font-size: 12px;
        }


        .hb-field {
            margin-bottom: 20px;
        }


        .hb-label {
            display: block;

            margin-bottom: 7px;

            color: #294963;

            font-size: 13px;

            font-weight: 650;
        }


        .hb-input-wrapper {
            position: relative;
        }


        .hb-input-icon {
            position: absolute;

            z-index: 2;

            left: 16px;

            top: 50%;

            transform:
                translateY(-50%);

            width: 20px;

            display: flex;

            align-items: center;

            justify-content: center;

            color: #8295a7;

            pointer-events: none;

            font-size: 17px;
        }


        .hb-input {
            width: 100%;

            height: 54px;

            padding:
                0 50px 0 48px;

            color: #173a5e;

            background: white;

            border:
                1px solid #cad8e5;

            border-radius: 11px;

            outline: none;

            font-size: 14px;

            transition:
                border-color 0.18s ease,
                box-shadow 0.18s ease,
                background 0.18s ease;
        }


        .hb-input::placeholder {
            color: #9eacb9;
        }


        .hb-input:focus {
            border-color: #0785dc;

            box-shadow:
                0 0 0 4px rgba(5, 132, 218, 0.11);

            background: white;
        }


        /* =====================================================
           ŞİFRE GÖSTER / GİZLE
           ===================================================== */

        .hb-password-toggle {
            position: absolute;

            z-index: 3;

            top: 50%;

            right: 15px;

            transform:
                translateY(-50%);

            width: 32px;

            height: 32px;

            padding: 0;

            display: flex;

            align-items: center;

            justify-content: center;

            color: #7e8f9e;

            background: transparent;

            border: none;

            border-radius: 7px;

            cursor: pointer;

            font-size: 16px;
        }


        .hb-password-toggle:hover {
            color: #0875c5;

            background: #edf6fc;
        }


        /* =====================================================
           BENİ HATIRLA
           ===================================================== */

        .hb-login-options {
            display: flex;

            align-items: center;

            justify-content: space-between;

            margin:
                3px 0 22px 0;
        }


        .hb-remember {
            display: flex;

            align-items: center;

            gap: 8px;

            margin: 0;

            color: #60788c;

            font-size: 13px;

            cursor: pointer;
        }


        .hb-remember input {
            width: 16px;

            height: 16px;

            margin: 0;

            cursor: pointer;
        }


        /* =====================================================
           BUTON
           ===================================================== */

        .hb-login-button {
            position: relative;

            width: 100%;

            height: 56px;

            overflow: hidden;

            display: flex;

            align-items: center;

            justify-content: center;

            border: none;

            border-radius: 11px;

            color: white;

            background:
                linear-gradient(
                    135deg,
                    #0d91e8 0%,
                    #0473c5 55%,
                    #005ca6 100%
                );

            font-size: 15px;

            font-weight: 700;

            cursor: pointer;

            box-shadow:
                0 8px 22px rgba(0, 105, 186, 0.25);

            transition:
                transform 0.18s ease,
                box-shadow 0.18s ease;
        }


        .hb-login-button:hover {
            transform:
                translateY(-2px);

            box-shadow:
                0 12px 27px rgba(0, 96, 174, 0.31);
        }


        .hb-button-arrow {
            position: absolute;

            right: 20px;

            font-size: 21px;

            font-weight: 300;
        }


        /* =====================================================
           KAYIT
           ===================================================== */

        .hb-register {
            display: flex;

            align-items: center;

            justify-content: center;

            gap: 6px;

            margin-top: 25px;

            color: #788b9c;

            font-size: 13px;
        }


        .hb-register::before,
        .hb-register::after {
            content: "";

            flex: 1;

            height: 1px;

            background: #e1e8ee;
        }


        .hb-register span {
            margin-left: 10px;

            white-space: nowrap;
        }


        .hb-register a {
            margin-right: 10px;

            color: #0875c5;

            font-weight: 700;

            text-decoration: none;

            white-space: nowrap;
        }


        .hb-register a:hover {
            text-decoration: underline;
        }


        /* =====================================================
           KART ALT
           ===================================================== */

        .hb-card-footer {
            display: flex;

            align-items: center;

            justify-content: center;

            gap: 7px;

            margin-top: 27px;

            padding-top: 20px;

            color: #93a2b0;

            border-top:
                1px solid #e6edf2;

            font-size: 11px;
        }


        /* =====================================================
           SAYFA FOOTER
           ===================================================== */

        .hb-page-footer {
            position: absolute;

            z-index: 4;

            left: 4.3%;

            bottom: 26px;

            color:
                rgba(255, 255, 255, 0.72);

            font-size: 11px;
        }


        /* =====================================================
           RESPONSIVE
           ===================================================== */

        @@media (max-width: 1100px) {

            .hb-login-brand {
                width: 52%;

                padding-left: 5%;
            }


            .hb-login-side {
                width: 48%;

                padding-right: 4%;
            }


            .hb-brand-title {
                font-size: 43px;
            }
        }


        @@media (max-width: 850px) {

            .hb-login-page {
                display: block;

                overflow-y: auto;
            }


            .hb-login-brand {
                display: none;
            }


            .hb-top-slogan {
                display: none;
            }


            .hb-login-side {
                width: 100%;

                min-height: 100vh;

                padding:
                    40px 20px 65px;
            }


            .hb-login-card {
                max-width: 480px;
            }


            .hb-page-footer {
                left: 50%;

                bottom: 14px;

                width: 100%;

                transform:
                    translateX(-50%);

                text-align: center;
            }
        }


        @@media (max-width: 500px) {

            .hb-login-card {
                padding:
                    34px 25px 27px;

                border-radius: 18px;
            }


            .hb-login-card h2 {
                font-size: 29px;
            }


            .hb-login-side {
                padding:
                    25px 14px 60px;
            }
        }

    </style>

</head>


<body>


    <main class="hb-login-page">


        <!-- SOL TARAF -->

        <section class="hb-login-brand">

            <div class="hb-brand-content">


                <div class="hb-brand-line"></div>


                <h1 class="hb-brand-title">

                    Problem Talep<br />
                    Takip Sistemi

                </h1>


                <p class="hb-brand-description">

                    Daha verimli süreçler,<br />
                    daha güçlü bir yarın için.

                </p>


                <div class="hb-features">


                    <div class="hb-feature">

                        <div class="hb-feature-icon">
                            ♙
                        </div>

                        <span class="hb-feature-title">
                            Ekip Odaklı<br />
                            Çözüm
                        </span>

                    </div>


                    <div class="hb-feature">

                        <div class="hb-feature-icon">
                            ◇
                        </div>

                        <span class="hb-feature-title">
                            Güvenli<br />
                            Erişim
                        </span>

                    </div>


                    <div class="hb-feature">

                        <div class="hb-feature-icon">
                            ↗
                        </div>

                        <span class="hb-feature-title">
                            Daha Etkin<br />
                            Takip
                        </span>

                    </div>


                </div>

            </div>

        </section>


        <!-- SAĞ ÜST -->

        <div class="hb-top-slogan">

            DAİMA DAHA FAZLASI

        </div>


        <!-- LOGIN KARTI -->

        <section class="hb-login-side">


            <div class="hb-login-card">


                <span class="hb-login-small-title">

                    HOŞ GELDİNİZ

                </span>


                <h2>

                    Giriş Yap

                </h2>


                <p class="hb-login-description">

                    Problem Talep Takip Sistemi'ne erişmek için
                    hesabınızla giriş yapın.

                </p>


                <form id="account"
                      method="post">


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger hb-validation"
                         role="alert">
                    </div>


                    <!-- E-POSTA -->

                    <div class="hb-field">


                        <label asp-for="Input.Email"
                               class="hb-label">

                            E-posta

                        </label>


                        <div class="hb-input-wrapper">


                            <span class="hb-input-icon">

                                ✉

                            </span>


                            <input asp-for="Input.Email"
                                   class="hb-input"
                                   autocomplete="username"
                                   aria-required="true"
                                   placeholder="ornek@halkbank.com.tr" />


                        </div>


                        <span asp-validation-for="Input.Email"
                              class="text-danger">
                        </span>


                    </div>


                    <!-- ŞİFRE -->

                    <div class="hb-field">


                        <label asp-for="Input.Password"
                               class="hb-label">

                            Şifre

                        </label>


                        <div class="hb-input-wrapper">


                            <span class="hb-input-icon">

                                ◇

                            </span>


                            <input asp-for="Input.Password"
                                   id="passwordInput"
                                   class="hb-input"
                                   autocomplete="current-password"
                                   aria-required="true"
                                   placeholder="Şifrenizi girin" />


                            <button type="button"
                                    class="hb-password-toggle"
                                    onclick="togglePassword()"
                                    aria-label="Şifreyi göster">

                                ◉

                            </button>


                        </div>


                        <span asp-validation-for="Input.Password"
                              class="text-danger">
                        </span>


                    </div>


                    <!-- OPTIONS -->

                    <div class="hb-login-options">


                        <label class="hb-remember">


                            <input asp-for="Input.RememberMe"
                                   class="form-check-input" />


                            <span>

                                Beni Hatırla

                            </span>


                        </label>


                    </div>


                    <!-- BUTTON -->

                    <button id="login-submit"
                            type="submit"
                            class="hb-login-button">


                        <span>
                            Giriş Yap
                        </span>


                        <span class="hb-button-arrow">

                            →

                        </span>


                    </button>


                    <!-- REGISTER -->

                    <div class="hb-register">


                        <span>

                            Hesabınız yok mu?

                        </span>


                        <a asp-page="./Register"
                           asp-route-returnUrl="@Model.ReturnUrl">

                            Kayıt Ol

                        </a>


                    </div>


                </form>


                <div class="hb-card-footer">


                    <span>
                        Güvenli erişim
                    </span>


                    <span>
                        •
                    </span>


                    <span>
                        Halkbank İç Sistem
                    </span>


                </div>


            </div>

        </section>


        <!-- FOOTER -->

        <div class="hb-page-footer">

            © 2026 Halkbank - Problem Talep Takip Sistemi
            &nbsp; | &nbsp;
            Halkbank İç Sistem

        </div>


    </main>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <script>

        function togglePassword() {

            const passwordInput =
                document.getElementById("passwordInput");

            if (passwordInput.type === "password") {

                passwordInput.type = "text";

            }
            else {

                passwordInput.type = "password";

            }

        }

    </script>


    <partial name="_ValidationScriptsPartial" />


</body>

</html>